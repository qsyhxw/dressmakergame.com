/ads/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: sandbox allow-scripts allow-same-origin; frame-ancestors https://dressmakergame.com https://www.dressmakergame.com

# The ad document must never become a same-origin iframe on the main site.
https://dressmakergame.com/ads/*
  Content-Security-Policy: frame-ancestors 'none'
https://www.dressmakergame.com/ads/*
  Content-Security-Policy: frame-ancestors 'none'
